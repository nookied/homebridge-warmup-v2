{
  "name": "homebridge-warmup4ie-v2",
  "displayName": "Homebridge Warmup Wi-Fi Thermostats",
  "version": "3.13.1",
  "description": "Homebridge plugin for Warmup Wi-Fi underfloor-heating thermostats (4iE, 6iE, 7iE, Element, Terra). Maintained fork of homebridge-warmup4ie with fixes for Homebridge 2.0 and the broken Off control in 0.1.0–0.1.1.",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix --max-warnings=0 .",
    "watch": "nodemon",
    "test": "jest --detectOpenHandles",
    "test-coverage": "jest --coverage",
    "smoke": "node -e \"const m = require('./src/index.js'); if (typeof m !== 'function') { process.exit(1); }\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nookied/homebridge-warmup-v2.git"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge-warmup4ie",
    "warmup4ie",
    "warmup",
    "warmup-6ie",
    "warmup-7ie",
    "warmup-element",
    "warmup-terra",
    "myheating",
    "thermostat",
    "underfloor-heating",
    "homekit"
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.5",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "nodemon": "^3.1.14"
  },
  "author": "Karol Nowacki (fork of NorthernMan54/homebridge-warmup4ie)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nookied/homebridge-warmup-v2/issues"
  },
  "homepage": "https://github.com/nookied/homebridge-warmup-v2#readme",
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js",
    "ignore": [],
    "exec": "DEBUG=HAP-NodeJS*,warmup4ie* ~/npm/bin/homebridge -U ./test/hbConfig -I -Q -T -D -P .",
    "signal": "SIGTERM",
    "env": {
      "NODE_OPTIONS": "--trace-warnings"
    }
  }
}
